# Ignore uncompressed SQLite files (only keep compressed)
*.sqlite

# The full archive exceeds 25MB; only its split parts are committed.
# Reassemble with: cat latest.db.gz.part-* > latest.db.gz
latest.db.gz

# Keep compressed database parts and metadata
!latest.db.gz.part-*
!latest.db.gz.sha256
!metadata.json
